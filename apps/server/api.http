@baseUrl = http://localhost:8787/api
@projectId = d09b0923-5d4b-4359-bac9-0eccd626da0e

### Health
GET {{baseUrl}}/health

### List projects
GET {{baseUrl}}/projects

### Get project by id
GET {{baseUrl}}/projects/{{projectId}}

### Add project
POST {{baseUrl}}/projects HTTP/1.1
Content-Type: application/json

{
  "name": "Test",
  "path": "/home/juan"
}

### Add project (error)
POST {{baseUrl}}/projects HTTP/1.1
Content-Type: application/json

{
  "name": null,
  "path": "/home/juan"
}

### Project duplicate (409)
POST {{baseUrl}}/projects HTTP/1.1
Content-Type: application/json

{
  "name": "Test again",
  "path": "/home/juan"
}
