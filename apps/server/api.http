Content-Type: application/json

{
  "path": "/home/juan/workspace/foe"
}

### Add project (error)
POST {{baseUrl}}/projects HTTP/1.1
Content-Type: application/json

{
  "path": null
}

### Project duplicate (409)
POST {{baseUrl}}/projects HTTP/1.1
Content-Type: application/json

{
  "path": "/home/juan/workspace/foe"
}

### Delete project
DELETE {{baseUrl}}/projects/{{projectId}}

