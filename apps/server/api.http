@baseUrl = http://localhost:8787/api
@wsUrl = ws://localhost:8787/ws
@projectId = d09b0923-5d4b-4359-bac9-0eccd626da0e
@agentId = fake

### Health
GET {{baseUrl}}/health

### List projects
GET {{baseUrl}}/projects

### Get project by id
GET {{baseUrl}}/projects/{{projectId}}

### Add project
POST {{baseUrl}}/projects HTTP/1.1
Content-Type: application/json

{
  "path": "/home/juan/workspace/foe"
}

### Add project (error)
POST {{baseUrl}}/projects HTTP/1.1
Content-Type: application/json

{
  "path": null
}

### Project duplicate (409)
POST {{baseUrl}}/projects HTTP/1.1
Content-Type: application/json

{
  "path": "/home/juan/workspace/foe"
}

### Delete project
DELETE {{baseUrl}}/projects/{{projectId}}

### Agents
GET {{baseUrl}}/agents

### Chat: start, prompt, cancel
# @websocket timeout=10s idle-timeout=30s max-message-bytes=1mb
# @ws send-json {"type":"start","projectId":"{{projectId}}","agentId":"{{agentId}}"}
# @ws wait 2s
# @ws send-json {"type":"prompt","text":"hello"}
# @ws wait 1s
# @ws send-json {"type":"cancel"}
GET {{wsUrl}}

### Chat: permission round-trip
# Copy requestId from the permission_request frame, then reply from the
# interactive console (Stream tab: g+w, i):
# {"type":"permission","requestId":"<id>","optionId":"proceed_once"}
# @websocket timeout=10s idle-timeout=30s max-message-bytes=1mb
# @ws send-json {"type":"start","projectId":"{{projectId}}","agentId":"{{agentId}}"}
# @ws wait 2s
# @ws send-json {"type":"prompt","text":"permission please"}
GET {{wsUrl}}
